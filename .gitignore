# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserdatad/
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (package-local build dir; Package.resolved stays tracked
# so the GRDB 7.x pin is reproducible)
Packages/.build*/

# Scratch SwiftPM build roots created with -Xswiftc/.build suffixes, and any
# repo-root scratch build dir (e.g. .build-integr).
/.build*/
.swiftpm/

# Scratch spike package: build dir AND resolved pin are local-only.
Spike/.build/
Spike/Package.resolved

# Generated by xcodegen from App/project.yml (source of truth)
App/AgentTerminal.xcodeproj/
App/Support/

# Zig + libghostty build artifacts
zig-cache/
zig-out/
*.o
*.a
*.dylib
*.xcframework

# Vendored libghostty: ignore the clone and all build outputs, but keep the
# pinned-commit metadata files tracked (architecture notes §4.1).
Vendor/*
!Vendor/Ghostty/
Vendor/Ghostty/*
!Vendor/Ghostty/commit.txt
!Vendor/Ghostty/README.md
!Vendor/Ghostty/patches.md
!Vendor/Ghostty/.gitignore

# Local tooling / scratch
*.log
.venv/
node_modules/
/.local/
/.omp/
/AGENTS.md
/42479
Spike/.scratch/
/Spike/RESULTS.md
