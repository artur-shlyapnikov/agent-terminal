<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hardened Runtime is enabled via the ENABLE_HARDENED_RUNTIME build setting,
		not via an entitlement. App Sandbox is deliberately OFF
		(architecture notes §2.1, §3.20): a terminal app must launch arbitrary
		user CLIs and read their configs.
		No JIT allowance (com.apple.security.cs.allow-jit) — not needed by the app
		or libghostty embedding.
	-->
</dict>
</plist>
